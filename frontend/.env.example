# Frontend Environment Variables

# The URL of your deployed backend API (or http://localhost:8000/api for local dev)
NEXT_PUBLIC_API_URL=https://void-backend-kia3.onrender.com/api

# Your Google OAuth Client ID (Get this from Google Cloud Console -> APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
